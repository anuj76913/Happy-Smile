# Copy to .env for local development only. In staging and production these values
# come from the secrets manager / deployment config, never from a committed file.

APP_ENV=dev                       # dev | staging | production
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/happysmile
IP_HASH_SALT=dev-only-salt        # secret in staging/production (required there)
COOKIE_SECURE=false               # must be true in staging/production
SESSION_HOURS=12

CALLER_ID=+91 90000 12345         # number shown to patients for assistant calls
CALLING_WINDOW_START=09:00
CALLING_WINDOW_END=21:00
LAST_CALL_CUTOFF_MIN=15

RATE_LIMIT_IP_PER_10MIN=20
RATE_LIMIT_PHONE_PER_HOUR=5

# Phase 3: must be true before any clinic's assistant share can go above 0.
VOICE_AGENT_ENABLED=false
TELEPHONY_PROVIDER=sim            # 'sim' = no real calls; 'browser' = rings the patient's browser tab (run-dev.ps1 -VoiceDemo). Both dev only
# DEDUPE_HOURS=24                 # merge repeat enquiries from the same number within this window (0 = off, demo only)
TELEPHONY_WEBHOOK_SECRET=         # HMAC secret for /v1/hooks/telephony/status
MAX_CONCURRENT_CALLS=10
STAFF_HOURS_START=09:00           # handover promises: "within N minutes" only inside these hours
STAFF_HOURS_END=21:00

# Groq (architecture §4.13). Leave empty to run on rules-only understanding.
GROQ_API_KEY=
LLM_DIALOGUE_MODEL=               # pin exact IDs from Groq's model list (see phase0/long-lead/groq)
LLM_GUARD_MODEL=
LLM_SUMMARY_MODEL=
LLM_FIRST_TOKEN_TIMEOUT_MS=800
LLM_TOTAL_TIMEOUT_MS=2500

# Phase 4: WhatsApp (Meta Cloud API) - 'sim' sends nothing
WHATSAPP_PROVIDER=sim             # sim | meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=              # verifies X-Hub-Signature-256 on /v1/hooks/whatsapp
WHATSAPP_VERIFY_TOKEN=            # Meta webhook verification handshake
WHATSAPP_GRAPH_VERSION=v21.0      # confirm the current Graph API version when setting up

# Phase 4: alerts and kill switch
ALERT_WEBHOOK_URL=                # incoming webhook (Slack/Teams); no personal data is sent
AUTO_KILL_SWITCH=true             # stop assistant on missed urgent handover; pause booking on >15% review rejections

# Phase 6: scale
PERMANENT_CONTROL_SHARE=0.1       # always kept on the standard callback; caps the assistant share at 90%
CALENDAR_API_URL=                 # external calendar adapter (see calendar_sync.py for the contract)
CALENDAR_API_TOKEN=
# LLM_BASE_URL=                   # any OpenAI-compatible endpoint, e.g. India-hosted; overrides GROQ_BASE_URL
# LLM_API_KEY=                    # overrides GROQ_API_KEY
# LLM_PROVIDER=groq               # label recorded with each LLM call

# Phase 5: unit prices for the readout's cost section (INR). Leave empty to skip costs.
COST_TELEPHONY_INR_PER_MIN=
COST_SPEECH_INR_PER_MIN=
COST_LLM_INR_PER_1K_TOKENS=
